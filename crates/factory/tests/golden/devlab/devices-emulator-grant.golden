# No phone is attached, so owner a's request boots an emulator. At the emulator cap (1), owner b
# gives up at once; once a releases it, the idle emulator is b's without a boot.
$ a@plain-a devlab acquire
1> export DEVLAB_LEASE=1
1> export ANDROID_SERIAL=emulator-5580
1> export DEVLAB_SERIALS=emulator-5580
1> export DEVLAB_KINDS=emulator
1> export DEVLAB_ABIS=x86_64
2> devlab: booting 1 emulator(s), about a minute (quick boot) or three (first boot)
2> devlab: lease 1, emulator emulator-5580
? 0
$ c@demo-c devlab acquire --no-device --quiet
1> export DEVLAB_PROJECT=demo
1> export DEVLAB_SLOT=0
1> export API_PORT=27787
1> export SUPABASE_API_PORT=27321
1> export SUPABASE_URL=http://127.0.0.1:27321
1> export SUPABASE_DB_PORT=27322
1> export SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:27322/postgres
1> export SUPABASE_STUDIO_PORT=27323
1> export SUPABASE_MAIL_PORT=27324
1> export SUPABASE_PROJECT_ID=demo
1> export SUPABASE_DB_CONTAINER=supabase_db_demo
1> export API_URL=http://127.0.0.1:27787
1> export DEVLAB_LEASE=2
? 0
$ b@plain-b devlab acquire --wait 0
2> devlab: gave up after 0 s: no free phone (0 phone(s) busy) and the emulator cap (1) is reached
? 75
$ a@plain-a devlab status
1> devices
1>   emulator-5580      emulator sdk gphone64 x ready        lease 1 plain-a (claude:<a>)
1> stack slots
