# The slot's stack fails to start: acquire --stack exits 78 naming its log and keeps the lease, and
# so does stack up. Once supabase starts again, stack up starts it. The next lease of that slot is
# warned that the stack ran another worktree's schema, and release --stop-stack stops it.
break supabase start
$ a@demo-a devlab acquire --no-device --stack
2> devlab: supabase start failed on slot 0 (exit 1); log: <sandbox>/state/devlab/logs/stack-demo-0.log
? 78
$ a@demo-a cat "$XDG_STATE_HOME/devlab/logs/stack-demo-0.log"
1> failed to start docker container: Bind for 0.0.0.0:27322 failed: port is already allocated
? 0
$ a@demo-a devlab stack up
2> devlab: supabase start failed on slot 0 (exit 1); log: <sandbox>/state/devlab/logs/stack-demo-0.log
? 78
$ a@demo-a devlab env
1> export DEVLAB_PROJECT=demo
1> export DEVLAB_SLOT=0
1> export API_PORT=27787
1> export SUPABASE_API_PORT=27321
1> export SUPABASE_URL=http://127.0.0.1:27321
1> export SUPABASE_DB_PORT=27322
1> export SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:27322/postgres
1> export SUPABASE_STUDIO_PORT=27323
1> export SUPABASE_MAIL_PORT=27324
1> export SUPABASE_PROJECT_ID=demo
1> export SUPABASE_DB_CONTAINER=supabase_db_demo
1> export API_URL=http://127.0.0.1:27787
1> export DEVLAB_LEASE=1
? 0
mend supabase start
$ a@demo-a devlab stack up
2> devlab: stack demo started on slot 0
? 0
$ a@demo-a devlab stack status
1> demo up
