# Owner a may hold one of demo's two slots (the default cap: all but one). Asking for a second gives
# up at once, naming the cap, while owner b still gets the other slot. A request of a's that waits
# over the cap steps aside, and is served when one of a's own leases ends.
$ a@demo-a devlab acquire --no-device --quiet
1> export DEVLAB_PROJECT=demo
1> export DEVLAB_SLOT=0
1> export API_PORT=27787
1> export SUPABASE_API_PORT=27321
1> export SUPABASE_URL=http://127.0.0.1:27321
1> export SUPABASE_DB_PORT=27322
1> export SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:27322/postgres
1> export SUPABASE_STUDIO_PORT=27323
1> export SUPABASE_MAIL_PORT=27324
1> export SUPABASE_PROJECT_ID=demo
1> export SUPABASE_DB_CONTAINER=supabase_db_demo
1> export API_URL=http://127.0.0.1:27787
1> export DEVLAB_LEASE=1
? 0
$ a@demo-b devlab acquire --no-device --wait 0
2> devlab: gave up after 0 s: owner claude:<a> already holds 1 of 2 demo stack slots; cap 1 (waits for one of its own leases to end)
? 75
$ b@demo-c devlab acquire --no-device --quiet
1> export DEVLAB_PROJECT=demo
1> export DEVLAB_SLOT=1
1> export API_PORT=27887
1> export SUPABASE_API_PORT=27421
1> export SUPABASE_URL=http://127.0.0.1:27421
1> export SUPABASE_DB_PORT=27422
1> export SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:27422/postgres
1> export SUPABASE_STUDIO_PORT=27423
1> export SUPABASE_MAIL_PORT=27424
1> export SUPABASE_PROJECT_ID=demo_s1
1> export SUPABASE_DB_CONTAINER=supabase_db_demo_s1
1> export SUPABASE_WORKDIR=<sandbox>/state/devlab/demo/slot-1
1> export API_URL=http://127.0.0.1:27887
1> export DEVLAB_LEASE=2
? 0
& later a@demo-d devlab acquire --no-device --wait 60
until later devlab: waiting:
$ b@demo-c devlab status
1> devices: none attached
1> stack slots
1>   demo 0   down                         lease 1 demo-a
1>   demo 1   down                         lease 2 demo-c
1>   demo per owner (cap 1 of 2): claude:<a> 1/1 at cap, claude:<b> 1/1 at cap
1> waiting: claude:<a> @ demo-d for 0m (owner at its slot cap)
1> memory <mem> GB free; watcher active
? 0
$ a@demo-a devlab release
2> devlab: released lease 1
? 0
wait later
1> export DEVLAB_PROJECT=demo
1> export DEVLAB_SLOT=0
1> export API_PORT=27787
1> export SUPABASE_API_PORT=27321
1> export SUPABASE_URL=http://127.0.0.1:27321
1> export SUPABASE_DB_PORT=27322
1> export SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:27322/postgres
1> export SUPABASE_STUDIO_PORT=27323
1> export SUPABASE_MAIL_PORT=27324
1> export SUPABASE_PROJECT_ID=demo
1> export SUPABASE_DB_CONTAINER=supabase_db_demo
1> export API_URL=http://127.0.0.1:27787
1> export DEVLAB_LEASE=3
2> devlab: waiting: owner claude:<a> already holds 1 of 2 demo stack slots; cap 1 (waits for one of its own leases to end)
2> devlab: lease 3, slot 0 (stack http://127.0.0.1:27321, down)
? 0
$ b@demo-c devlab status
1> devices: none attached
1> stack slots
1>   demo 0   down                         lease 3 demo-d
1>   demo 1   down                         lease 2 demo-c
1>   demo per owner (cap 1 of 2): claude:<b> 1/1 at cap, claude:<a> 1/1 at cap
1> memory <mem> GB free; watcher active
? 0
