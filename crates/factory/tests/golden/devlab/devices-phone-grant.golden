# Free phones go out in serial order: owner a gets the first and runs commands on it (run passes the
# command's exit code through); owner b gets the next authorized one, whose lock screen stays up.
# With the last phone unauthorized, owner c gives up at once.
plug FAKEPHONE01 device usb:1-1 product:shiba model:Pixel_8 device:shiba transport_id:1
plug FAKEPHONE02 unauthorized usb:1-2 transport_id:2
plug FAKEPHONE03 device usb:1-3 product:panther model:Pixel_7 device:panther transport_id:3
lock FAKEPHONE03
$ a@plain-a devlab acquire
1> export DEVLAB_LEASE=1
1> export ANDROID_SERIAL=FAKEPHONE01
1> export DEVLAB_SERIALS=FAKEPHONE01
1> export DEVLAB_KINDS=phone
1> export DEVLAB_ABIS=arm64-v8a
2> devlab: lease 1, phone FAKEPHONE01 (Pixel 8)
? 0
$ a@plain-a devlab run -- sh -c 'echo "on $ANDROID_SERIAL ($DEVLAB_KINDS, $DEVLAB_ABIS)"; exit 3'
1> on FAKEPHONE01 (phone, arm64-v8a)
2> devlab: lease 1, phone FAKEPHONE01 (Pixel 8)
? 3
$ a@plain-a devlab exec -- sh -c 'echo "lease $DEVLAB_LEASE: $DEVLAB_SERIALS"'
1> lease 1: FAKEPHONE01
? 0
$ a@plain-a devlab stack status
2> devlab: this lease has no stack slot (devlab.json has no supabase)
? 3
$ b@plain-b devlab acquire --phone
1> export DEVLAB_LEASE=2
1> export ANDROID_SERIAL=FAKEPHONE03
1> export DEVLAB_SERIALS=FAKEPHONE03
1> export DEVLAB_KINDS=phone
1> export DEVLAB_ABIS=arm64-v8a
2> devlab: FAKEPHONE03: lock screen still showing: set the phone's screen lock to None or Swipe
2> devlab: lease 2, phone FAKEPHONE03 (Pixel 7)
? 0
$ c@plain-c devlab acquire --phone --wait 0
2> devlab: gave up after 0 s: no free phone: 2 phone(s) busy, 1 unauthorized (tap Allow on the phone)
? 75
$ a@plain-a devlab status
1> devices
1>   FAKEPHONE01        phone    Pixel 8        ready        lease 1 plain-a (claude:<a>)
1>   FAKEPHONE02        phone    -              unauthorized free
1>   FAKEPHONE03        phone    Pixel 7        locked       lease 2 plain-b (claude:<b>)
1> leases
1>   lease 1 plain-a (claude:<a>): age 0m, idle 0m
1>   lease 2 plain-b (claude:<b>): age 0m, idle 0m
1> memory <mem> GB free; watcher active
? 0
