# Owner a's phone is unplugged: env and exec exit 76 naming it, and so does env when it comes back
# offline. acquire tops the same lease up with another phone.
plug FAKEPHONE01 device usb:1-1 model:Pixel_8
$ a@plain-a devlab acquire --quiet
1> export DEVLAB_LEASE=1
1> export ANDROID_SERIAL=FAKEPHONE01
1> export DEVLAB_SERIALS=FAKEPHONE01
1> export DEVLAB_KINDS=phone
1> export DEVLAB_ABIS=arm64-v8a
? 0
unplug FAKEPHONE01
$ a@plain-a devlab env
2> devlab: phone FAKEPHONE01 (Pixel 8) is unplugged: run devlab acquire to replace it
? 76
$ a@plain-a devlab exec -- true
2> devlab: phone FAKEPHONE01 (Pixel 8) is unplugged: run devlab acquire to replace it
? 76
plug FAKEPHONE01 offline usb:1-1
$ a@plain-a devlab env
2> devlab: phone FAKEPHONE01 (Pixel 8) is offline: run devlab acquire to replace it
? 76
$ a@plain-a devlab status
1> devices
1>   FAKEPHONE01        phone    Pixel 8        offline      lease 1 plain-a (claude:<a>)
1> memory <mem> GB free; watcher active
? 0
plug FAKEPHONE02 device usb:1-2 model:Pixel_7
$ a@plain-a devlab acquire
1> export DEVLAB_LEASE=1
1> export ANDROID_SERIAL=FAKEPHONE02
1> export DEVLAB_SERIALS=FAKEPHONE02
1> export DEVLAB_KINDS=phone
1> export DEVLAB_ABIS=arm64-v8a
2> devlab: lease 1, phone FAKEPHONE02 (Pixel 7)
? 0
$ a@plain-a devlab status
1> devices
1>   FAKEPHONE01        phone    -              offline      free
1>   FAKEPHONE02        phone    Pixel 7        ready        lease 1 plain-a (claude:<a>)
1> memory <mem> GB free; watcher active
? 0
