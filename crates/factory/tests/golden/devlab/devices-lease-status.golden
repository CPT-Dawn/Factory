# Status shows each lease's age, how long it has run nothing and the command it runs (#57), and
# each phone's readiness (#55): the phone whose lock screen stays up shows as locked. An exec
# running on a lease is its command until it ends.
plug FAKEPHONE01 device usb:1-1 product:shiba model:Pixel_8 device:shiba transport_id:1
plug FAKEPHONE02 device usb:1-2 product:panther model:Pixel_7 device:panther transport_id:2
lock FAKEPHONE02
$ a@plain-a devlab acquire --phone --quiet
1> export DEVLAB_LEASE=1
1> export ANDROID_SERIAL=FAKEPHONE01
1> export DEVLAB_SERIALS=FAKEPHONE01
1> export DEVLAB_KINDS=phone
1> export DEVLAB_ABIS=arm64-v8a
? 0
$ b@plain-b devlab acquire --phone --quiet
1> export DEVLAB_LEASE=2
1> export ANDROID_SERIAL=FAKEPHONE02
1> export DEVLAB_SERIALS=FAKEPHONE02
1> export DEVLAB_KINDS=phone
1> export DEVLAB_ABIS=arm64-v8a
2> devlab: FAKEPHONE02: lock screen still showing: set the phone's screen lock to None or Swipe
? 0
& r a@plain-a exec devlab exec -- sh -c 'echo started; sleep 30'
until r started
$ a@plain-a devlab status
1> devices
1>   FAKEPHONE01        phone    Pixel 8        ready        lease 1 plain-a (claude:<a>)
1>   FAKEPHONE02        phone    Pixel 7        locked       lease 2 plain-b (claude:<b>)
1> leases
1>   lease 1 plain-a (claude:<a>): age 0m, idle 0m, running sh -c echo started; sleep 30
1>   lease 2 plain-b (claude:<b>): age 0m, idle 0m
1> memory <mem> GB free; watcher active
? 0
$ a@plain-a devlab status --json
1> {
1>   "devices": [
1>     {
1>       "serial": "FAKEPHONE01",
1>       "kind": "phone",
1>       "model": "Pixel 8",
1>       "state": "ready",
1>       "holder": "lease 1 plain-a (claude:<a>)",
1>       "readiness": "ready"
1>     },
1>     {
1>       "serial": "FAKEPHONE02",
1>       "kind": "phone",
1>       "model": "Pixel 7",
1>       "state": "ready",
1>       "holder": "lease 2 plain-b (claude:<b>)",
1>       "readiness": "locked"
1>     }
1>   ],
1>   "leases": [
1>     {
1>       "id": 1,
1>       "worktree": "plain-a",
1>       "owner": "claude:<a>",
1>       "ageMin": 0,
1>       "idleMin": 0,
1>       "running": "sh -c echo started; sleep 30"
1>     },
1>     {
1>       "id": 2,
1>       "worktree": "plain-b",
1>       "owner": "claude:<b>",
1>       "ageMin": 0,
1>       "idleMin": 0,
1>       "running": null
1>     }
1>   ],
1>   "slots": [],
1>   "owners": [],
1>   "waiting": [],
1>   "watcher": "active",
1>   "memAvailableMB": <mem>
1> }
? 0
signal r TERM
wait r
1> started
2> devlab: sh stopped by SIGTERM after <n> s
? 143
$ a@plain-a devlab status
1> devices
1>   FAKEPHONE01        phone    Pixel 8        ready        lease 1 plain-a (claude:<a>)
1>   FAKEPHONE02        phone    Pixel 7        locked       lease 2 plain-b (claude:<b>)
1> leases
1>   lease 1 plain-a (claude:<a>): age 0m, idle 0m
1>   lease 2 plain-b (claude:<b>): age 0m, idle 0m
1> memory <mem> GB free; watcher active
? 0
